# nub trustPolicy=no-downgrade excludes (comma-separated). benign transitive deps that dropped
# provenance attestation an earlier release carried; safe, documented.
#   undici@5.29.0 — older major, no provenance on re-resolution
#   express-rate-limit@8.3.0 — single release published without provenance (restored in 8.3.1+)
trustPolicyExclude=undici,express-rate-limit
