# Generate with: openssl rand -hex 32
SELF_HOST_SECRET=your-random-secret-here

# Port for the API server
PORT=3456

# Directory for SQLite database and file uploads
DATA_DIR=./data

# Externally-reachable URL (used for upload links in PR comments)
# Set this to your actual public URL when deploying behind a reverse proxy
PUBLIC_URL=http://localhost:3456
